# ConvertIt Environment Configuration Example
# Copy to .env and adjust values for your environment.

# ==========================================
# Server & Network
# ==========================================
PORT=8000
# Exact comma-separated list of allowed CORS origins.
# Refuses to start in production if empty or contains '*'
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# How to find the real client IP behind reverse proxies (used for per-IP rate limits).
# Number of trusted proxies that append to X-Forwarded-For; the client IP is taken that
# many entries from the right. 0 = use the socket address (local dev / no proxy).
# Behind Render use 1: Render's proxy appends the connecting client's IP. Without it every
# visitor shares Render's proxy address and one rate-limit bucket.
TRUSTED_PROXY_HOPS=0
# Optional header your edge sets to the real client IP and that clients can't override
# (e.g. true-client-ip or cf-connecting-ip). Takes precedence over X-Forwarded-For.
CLIENT_IP_HEADER=
# Temporary storage directory for job files (wiped on startup)
TMP_DIR=/tmp/convertit

# ==========================================
# Authentication & Access Control (Optional)
# ==========================================
# If set, every API route except /api/health and /api/limits requires X-Access-Code header
ACCESS_CODE=

# ==========================================
# Feature Flags
# ==========================================
# Set to false to disable all YouTube downloader endpoints and UI features cleanly
ENABLE_YOUTUBE=true

# ==========================================
# Queue & Concurrency Management
# ==========================================
# Queue backend: 'memory' (in-process asyncio) or 'redis'
QUEUE_BACKEND=memory
# Required only if QUEUE_BACKEND=redis
REDIS_URL=redis://localhost:6379/0

# Maximum concurrent executions per job class
CONCURRENCY_HEAVY=1
CONCURRENCY_YOUTUBE=1
CONCURRENCY_LIGHT=2

# Maximum length of the global pending queue before returning QUEUE_FULL
MAX_QUEUE_LENGTH=20
# Maximum active (queued or running) jobs per client IP
MAX_ACTIVE_JOBS_PER_IP=2

# Grace period in seconds for draining running jobs on SIGTERM
SHUTDOWN_GRACE_SEC=30

# ==========================================
# Rate Limits
# ==========================================
# General API requests per minute per IP
RATE_LIMIT_PER_MIN=60
# Job creation requests per 10 minutes per IP
JOB_CREATES_PER_10MIN=20

# ==========================================
# Resource Limits & Guards
# ==========================================
# Maximum general upload file size in megabytes
MAX_UPLOAD_MB=25
# Maximum temporary disk usage before returning SERVER_BUSY
MAX_TMP_DISK_MB=2000
# Minimum free RAM in megabytes required to admit heavy jobs (psutil memory guard)
MIN_FREE_MEM_MB=300

# ==========================================
# Timeouts & TTLs
# ==========================================
# Maximum running execution time for YouTube download jobs
JOB_TIMEOUT_YOUTUBE_SEC=900
# Maximum running execution time for heavy conversion jobs (LibreOffice, etc.)
JOB_TIMEOUT_HEAVY_SEC=180
# Retention period for completed job output files before automatic disk deletion
JOB_RESULT_TTL_MIN=15
# Retention period for job metadata records in the job store
JOB_RECORD_TTL_MIN=60

# ==========================================
# YouTube Download Configuration
# ==========================================
# Maximum video duration permitted for download in minutes
YT_MAX_DURATION_MIN=60
# Hard limit on downloaded media size in megabytes
YT_MAX_FILESIZE_MB=300
# Maximum video height / vertical resolution permitted
YT_MAX_HEIGHT=1080
# Optional path to a netscape-formatted cookies.txt file mounted for yt-dlp
YT_COOKIES_FILE=
# Optional upstream proxy URL for yt-dlp requests (e.g. socks5://127.0.0.1:1080)
YT_PROXY=

# ==========================================
# Chat with PDF (RAG) — LLM Provider
# ==========================================
# API key for the LLM provider (OpenAI-compatible endpoint)
GEMINI_API_KEY=your_key_here
# Base URL of the OpenAI-compatible API
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Model identifier to use for chat completions
GEMINI_MODEL=gemini-3.1-flash-lite

# ==========================================
# Frontend Configuration (apps/web)
# ==========================================
VITE_API_BASE_URL=http://localhost:8000
